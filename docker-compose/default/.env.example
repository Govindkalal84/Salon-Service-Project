# Database Configuration
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3307

# RabbitMQ / CloudAMQP Credentials (replace with your own)
SPRING_RABBITMQ_HOST=frog.lmq.cloudamqp.com
SPRING_RABBITMQ_PORT=5671
SPRING_RABBITMQ_USERNAME=your_rabbitmq_username
SPRING_RABBITMQ_PASSWORD=your_rabbitmq_password
SPRING_RABBITMQ_VIRTUAL_HOST=your_virtual_host
SPRING_RABBITMQ_SSL_ENABLED=true

# Service Discovery & Gateway
EUREKA_SERVER_URL=http://eurekaserver:8070/eureka/
GATEWAY_PORT=5000
